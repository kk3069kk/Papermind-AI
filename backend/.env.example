# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000
PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# Prisma accepts a standard PostgreSQL URL (no +asyncpg / +psycopg2 suffix)
DATABASE_URL=postgresql://papermind:papermind@localhost:5432/papermind

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Pick exactly ONE provider: openai | openrouter | gemini | anthropic
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# OpenRouter  (set LLM_PROVIDER=openrouter to use)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Google Gemini  (used for embeddings; also set LLM_PROVIDER=gemini to use for chat)
# If GEMINI_API_KEY is unset in development, embeddings + LLM run in local mock mode.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude  (set LLM_PROVIDER=anthropic to use)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Cloudinary (optional locally — files are stored under ./uploads if unset) ─
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072

# ── RAG tuning ────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5
FAISS_INDEX_PATH=./faiss_index

# ── Upload ────────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
